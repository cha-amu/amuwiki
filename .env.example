# Public build-time settings only. Never put secrets here.
# The blog owns the wiki page layout; this repo serves its snapshot and graph iframe.
# Visitor routes and graph document links default to this blog origin + /wiki/.
# VITE_BLOG_URL=https://cha-amu.github.io/
# For local blog integration (snapshot/embed remain on this repo's server):
# VITE_BLOG_URL=http://127.0.0.1:5178/

# Optional explicit BLOG wiki page override. Relative paths resolve against the blog.
# VITE_WIKI_URL=http://127.0.0.1:5178/wiki/
# VITE_WIKI_BASE_URL is a legacy alias; VITE_WIKI_URL takes precedence.
# Do not point either at the /amuwiki/ publication root.

# Public JSON stays at the current publication origin + Vite base + wiki.json.
# VITE_WIKI_INDEX_URL=http://127.0.0.1:5173/amuwiki/wiki.json
# VITE_PUBLIC_INDEX_URL is the legacy index alias.
# VITE_BASE_PATH=/amuwiki/

# Open /amuwiki/?embed=graph&scope=all for the graph without redirecting.
# Deploy redirects only AFTER the blog's /wiki/ route is live.
